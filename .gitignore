# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# Cloudflare / OpenNext
/.open-next/
/.wrangler/
.dev.vars*
cloudflare-env.d.ts

# Playwright (trazas y artefactos de los E2E)
/test-results/
/playwright-report/
/blob-report/
/.playwright/

# Testsprite
# Ignora directorio temporal y artefactos generados por la herramienta de pruebas
testsprite_tests/tmp/
testsprite_tests/standard_prd.json
testsprite_tests/testsprite_frontend_test_plan.json
.env*.local

# InsForge & AI agent skills
.insforge
.agent
/agent/
.agents
.augment
.claude
.cline
.github/copilot*
.kilocode
.qoder
.qwen
.roo
.trae
.windsurf
