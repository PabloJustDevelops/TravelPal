{
  "name": "app-viajes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:e2e": "playwright test",
    "analyze": "cross-env ANALYZE=true next build",
    "type-check": "tsc --noEmit",
    "build:analyze": "cross-env ANALYZE=true next build",
    "test:tester": "cross-env E2E_TELEMETRY_DISABLED=1 e2e run",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --project=storybook",
    "test:timezone": "cross-env TZ=Europe/Madrid jest --runInBand --coverage=false src/components/dashboard/__tests__/NextTrip.test.tsx"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@insforge/sdk": "^1.5.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.22",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.0",
    "next": "^16.3.8",
    "react": "19.1.0",
    "react-calendar": "^6.0.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.64.0",
    "recharts": "^3.2.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@e2e-dev/web": "0.14.0",
    "@opennextjs/cloudflare": "^1.20.8",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/nextjs-vite": "10.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/runner": "4.1.11",
    "@vitest/ui": "4.1.11",
    "cross-env": "^7.0.3",
    "e2e": "0.19.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "storybook": "10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vite": "7.3.7",
    "vitest": "4.1.11",
    "webpack-bundle-analyzer": "^4.9.1",
    "whatwg-fetch": "^3.6.19",
    "wrangler": "^4.125.0",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@12.3.4"
}
